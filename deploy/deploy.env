# 무중단(블루·그린) 배포에서 쓰는 포트와 이름. 비밀 값은 넣지 않는다 (공개 저장소).
# deploy/run.sh가 서버의 ~/blogville/.env로 옮기고, docker compose(compose.yml)와 nginx 설정이 이 값을 쓴다.
# 비밀 값(DB 주소·로그인 비밀키·소셜 로그인 키)은 배포 때 GitHub 시크릿으로 ~/blogville/app.env를 만들어 넣는다.

# 사용자가 들어오는 포트. nginx가 받는다
PROXY_PORT=8400
# 앱 두 벌. 한쪽이 서비스하는 동안 다른 쪽에 새 버전을 띄운다
BLUE_PORT=8401
GREEN_PORT=8402
# 앞단 nginx 이미지
NGINX_IMAGE=nginx:1.27-alpine
# 새 버전으로 넘긴 뒤 이전 버전이 하던 요청을 마칠 때까지 기다리는 시간(초)
DRAIN_SECONDS=15
